# ===========================================
# RECRUITER IN A BOX - PRODUCTION ENV TEMPLATE
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Application
APP_NAME="Recruiter In A Box"
APP_VERSION="1.0.0"
DEBUG=false

# Database (Supabase PostgreSQL)
# Format: postgresql://postgres:PASSWORD@db.PROJECT_ID.supabase.co:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres?sslmode=require"
DATABASE_SSL_MODE="require"

# Security - CHANGE THIS!
# Generate with: openssl rand -hex 32
SECRET_KEY="generate-a-unique-secret-key-at-least-32-characters-long"

# JWT Configuration
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend URL (for CORS and redirects)
FRONTEND_URL="https://yourdomain.com"
CORS_ORIGINS='["https://yourdomain.com"]'

# ===========================================
# EXTERNAL SERVICES - GET FROM RESPECTIVE DASHBOARDS
# ===========================================

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4-turbo-preview"

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PROFESSIONAL="price_..."
STRIPE_PRICE_AGENCY="price_..."

# Email (Resend recommended - https://resend.com)
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASSWORD="re_..."
EMAIL_FROM="noreply@yourdomain.com"

# Supabase (if using - https://supabase.com)
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_KEY="your-anon-key"
SUPABASE_SERVICE_KEY="your-service-key"

# ===========================================
# OPTIONAL SERVICES
# ===========================================

# Redis (for rate limiting - recommended)
REDIS_URL="redis://default:password@host:6379"

# Sentry Error Tracking (https://sentry.io)
SENTRY_DSN="https://key@sentry.io/project"
SENTRY_ENVIRONMENT="production"

# ===========================================
# DEPLOYMENT SPECIFIC (Railway sets these)
# ===========================================
# PORT=8000
# HOST=0.0.0.0
