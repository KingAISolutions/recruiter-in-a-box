# Application
APP_NAME=Recruiter In A Box
APP_VERSION=1.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Frontend URL (for redirects)
FRONTEND_URL=https://your-domain.com

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recruiter_in_a_box
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recruiter_in_a_box

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# OpenAI (optional - required for AI features)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview

# Stripe (required for subscriptions)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PROFESSIONAL=price_professional_id
STRIPE_PRICE_AGENCY=price_agency_id

# Supabase (optional - for cloud storage)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_KEY=your-supabase-service-key

# Email (optional - simulated in development)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@recruiterinabox.com

# CORS
CORS_ORIGINS=["https://your-domain.com","https://www.your-domain.com"]

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Trial Settings
TRIAL_DAYS=14

# pgAdmin (optional)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
